# ============================================================
# SENTINEL (PRAVAHA) — Environment Configuration
# Copy to .env and fill in values
# ============================================================

# --- Application ---
APP_NAME=sentinel
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1

# --- GPU ---
CUDA_DEVICE=0
VRAM_LIMIT_MB=5120
ENABLE_TENSORRT=true

# --- Model Paths ---
YOLO_MODEL_PATH=models/yolov8n.engine
RAFT_MODEL_PATH=models/raft_small.pth
CSRNET_MODEL_PATH=models/csrnet.pth
LSTM_AE_MODEL_PATH=models/lstm_ae.pth
STGCNN_MODEL_PATH=models/stgcnn.pth

# --- Pipeline ---
TARGET_FPS=25
MAX_QUEUE_SIZE=30
FRAME_SKIP_HEAVY=3
ENABLE_VISUALIZATION=true

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL ---
POSTGRES_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_db

# --- MongoDB Atlas (Cloud) ---
MONGODB_URL=mongodb+srv://gowsikbabubabu_db_user:sentinel@cluster0.1g1pkb2.mongodb.net/?appName=Cluster0
MONGODB_DB=sentinel_detections

# --- InfluxDB ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=sentinel-token
INFLUXDB_ORG=sentinel
INFLUXDB_BUCKET=metrics

# --- RTSP Cameras ---
CAMERA_0_URL=rtsp://192.168.1.100:554/stream1
CAMERA_1_URL=rtsp://192.168.1.101:554/stream1

# --- Prometheus ---
METRICS_ENABLED=true
